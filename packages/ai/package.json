{
  "name": "@luanpoppe/ai",
  "version": "1.2.1",
  "description": "TypeScript SDK for LLM chat, structured output, memory, audio STT/TTS, and embeddings via OpenAI, Gemini, OpenRouter, and local models (Ollama/LM Studio).",
  "license": "ISC",
  "author": "Luan Poppe",
  "keywords": [
    "ai",
    "llm",
    "openai",
    "gemini",
    "openrouter",
    "langchain",
    "langgraph",
    "embeddings",
    "stt",
    "tts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luanpoppe/luanpoppe-libs.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/luanpoppe/luanpoppe-libs/tree/main/packages/ai#readme",
  "bugs": {
    "url": "https://github.com/luanpoppe/luanpoppe-libs/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "pub": "pnpm publish --access=public",
    "prepublishOnly": "pnpm typecheck && pnpm test:unit && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "vitest run tests/e2e",
    "test:unit": "vitest run tests/unit"
  },
  "packageManager": "pnpm@10.26.2",
  "dependencies": {
    "@langchain/ollama": "^1.2.6",
    "@langchain/langgraph": "^1.1.1",
    "openai": "^6.17.0",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.12",
    "@langchain/openai": "^1.2.3",
    "langchain": "^1.2.12",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@langchain/langgraph-checkpoint-mongodb": "^1.1.7",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@langchain/langgraph-checkpoint-redis": "^1.0.2",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "mongodb": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "dotenv": "^17.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

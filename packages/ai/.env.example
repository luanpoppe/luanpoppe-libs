# Variáveis de ambiente necessárias APENAS para os testes E2E

# OpenAI API Key (obrigatória para testes com GPT)
OPENAI_API_KEY=sk-...

# Google Gemini Token (obrigatória para testes com Gemini)
GOOGLE_GEMINI_TOKEN=...

# Obrigatória para testes com OpenRouter
OPENROUTER_API_KEY=...

# --- Modelos locais (testes E2E opcionais: ai-local-models) ---

# Ollama nativo: defina OLLAMA_E2E=1 com Ollama rodando (ollama serve)
# OLLAMA_E2E=1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL_NAME=llama3.2

# LM Studio / Ollama OpenAI-compatible: servidor em /v1 ativo
# LOCAL_BASE_URL=http://localhost:1234/v1
# LOCAL_MODEL_NAME=nome-exato-do-modelo-no-servidor
# LOCAL_API_KEY=not-needed